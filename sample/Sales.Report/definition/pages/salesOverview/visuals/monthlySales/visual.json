{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.1.0/schema.json",
  "name": "monthlySales",
  "position": {"x": 24, "y": 240, "z": 6, "height": 240, "width": 800, "tabOrder": 6},
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {"Column": {"Expression": {"SourceRef": {"Entity": "Date"}}, "Property": "YearMonth"}},
              "queryRef": "Date.YearMonth",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {"Measure": {"Expression": {"SourceRef": {"Entity": "Sales"}}, "Property": "Total Sales"}},
              "queryRef": "Sales.Total Sales"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [{"field": {"Column": {"Expression": {"SourceRef": {"Entity": "Date"}}, "Property": "YearMonth"}}, "direction": "Ascending"}],
        "isDefaultSort": false
      }
    },
    "objects": {
      "dataPoint": [{"properties": {"defaultColor": {"solid": {"color": {"expr": {"Literal": {"Value": "'#087F8C'"}}}}}}}]
    },
    "visualContainerObjects": {
      "title": [{"properties": {"show": {"expr": {"Literal": {"Value": "true"}}}, "text": {"expr": {"Literal": {"Value": "'Monthly Sales'"}}}}}]
    }
  }
}